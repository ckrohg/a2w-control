<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- @purpose launchd job for scripts/pi-backup-pull.sh: pull the Pi's newest
       SQLite backup to this Mac every morning at 04:07 local time. Missed runs
       (Mac asleep or off) fire at the next wake. Install:
         cp scripts/launchd/com.a2w.pi-backup-pull.plist ~/Library/LaunchAgents/
         sed -i '' "s|__REPO__|$PWD|" ~/Library/LaunchAgents/com.a2w.pi-backup-pull.plist
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.a2w.pi-backup-pull.plist
       Status: launchctl print gui/$(id -u)/com.a2w.pi-backup-pull ; log: ~/a2w-pi-backups/pull.log -->
  <key>Label</key><string>com.a2w.pi-backup-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/pi-backup-pull.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>7</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/com.a2w.pi-backup-pull.out</string>
  <key>StandardErrorPath</key><string>/tmp/com.a2w.pi-backup-pull.err</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string></dict>
</dict>
</plist>
