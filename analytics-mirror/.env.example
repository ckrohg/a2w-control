# Copy to .env.local for local dev; on Vercel set these as Environment Variables.
# Every variable here is read on the server only (none is NEXT_PUBLIC_*). Lines marked
# SERVER-ONLY SECRET must never be renamed to NEXT_PUBLIC_* or echoed to the browser.
# See README.md ("Environment variables") for which feature each group switches on.

# --- Ingest & storage ---------------------------------------------------------
# SERVER-ONLY SECRET. Bearer the Pi sends to /api/ingest; must match `analytics.token`
# in the Pi's ~/bridge-data/config.yaml.
INGEST_TOKEN=change-me-to-a-long-random-string
# SERVER-ONLY SECRET. Railway Postgres TCP-proxy URL (Railway -> a2w-hub project -> Postgres
# -> Variables). Read first by lib/sql.ts; the dashboard must not depend on integration-owned vars.
A2W_DATABASE_URL=postgresql://postgres:password@your-proxy.proxy.rlwy.net:12345/railway
# Fallbacks only (legacy Vercel/Neon integration, local dev). Leave unset in prod.
# DATABASE_URL=postgresql://localhost:5432/a2w_local
# POSTGRES_URL=postgresql://localhost:5432/a2w_local

# --- Login / passkey ----------------------------------------------------------
# SERVER-ONLY SECRET. Dashboard login password; re-entered to obtain the 5-minute arm cookie.
VIEW_PASSWORD=your-dashboard-password
# SERVER-ONLY SECRET. A DIFFERENT random string: the session cookie's value (never the
# password); with VIEW_PASSWORD it keys the arm cookie's signature.
VIEW_SESSION_SECRET=another-long-random-string
# WebAuthn relying-party ID = the host you serve on (default a2w-analytics-mirror.vercel.app).
WEBAUTHN_RP_ID=your-project.vercel.app
# Full origin for WebAuthn verification (default https://<WEBAUTHN_RP_ID>).
WEBAUTHN_ORIGIN=https://your-project.vercel.app

# --- Hub control (/control page; talks to the Railway hub, never the Pi directly) ----
# Base URL of the Railway hub, no trailing slash. Proxied by app/api/hub/*.
HUB_URL=https://your-hub-host.up.railway.app
# SERVER-ONLY SECRET. Must match the hub's HUB_CLIENT_TOKEN.
HUB_CLIENT_TOKEN=another-long-random-string
# SERVER-ONLY SECRET. Must match the hub's HUB_ARM_TOKEN; sent as X-Arm-Token for
# write-enable and breaker actions only after a fresh password re-entry. Unset = those are off.
HUB_ARM_TOKEN=yet-another-long-random-string

# --- Planner (/optimize page, storm banner, savings) --------------------------
# Base URL of the Railway planner, no trailing slash. Proxied by app/api/planner/*.
PLANNER_URL=https://your-planner-host.up.railway.app
# SERVER-ONLY SECRET. Bearer for the planner's authenticated /api/* routes. Its /health is
# open, but the mirror's readers send this there too and report "not configured" without it.
PLANNER_API_TOKEN=another-long-random-string

# --- Weekly digest (/api/digest, cron Mondays 12:00 UTC per vercel.json) ------
# SERVER-ONLY SECRET. Vercel's cron presents it as the bearer; also accepted as ?key=.
CRON_SECRET=another-long-random-string
# SERVER-ONLY SECRET. Resend API key; missing -> the route answers {skipped}, never errors.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Recipient of the weekly email; missing -> {skipped} as well.
DIGEST_TO=you@example.com
# Sender (default "A2W Control <onboarding@resend.dev>"; a verified domain is needed otherwise).
DIGEST_FROM=A2W Control <onboarding@resend.dev>
# $/kWh for the digest's backup-element cost line (default 0.31).
DIGEST_RATE_USD_KWH=0.31

# --- Display ------------------------------------------------------------------
# IANA time zone for server-rendered timestamps (default America/New_York).
DISPLAY_TZ=America/New_York
# $/kWh for the Savings and Optimize pages (default 0.30).
ELECTRIC_RATE_USD_KWH=0.30
# Baseline daily kWh for the savings estimate (default 11.8).
DAILY_KWH_BASELINE=11.8
